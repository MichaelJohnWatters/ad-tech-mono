# Data lake - the COLD store batch layer (internals)
# Render: make diagrams
# How the pipeline turns the event stream into a real Delta table that DuckDB
# delta_scan can read. The system-level flow is in data-reporting.md.

direction: right

# ============================================================
# Inputs
# ============================================================
nats: NATS JetStream {
  shape: queue
  style.fill: "#22c55e"
  style.font-color: "#fff"
}
files: "Drop-zone files (csv/tsv/parquet, zip+gzip auto-detected) - adtech-onboarding/<provider>/incoming/" {
  shape: page
  style.fill: "#e2e8f0"
}

# ============================================================
# Pipeline - the datalake sink  (cmd/pipeline)
# ============================================================
sink: Pipeline - datalake sink :8087 {
  style.fill: "#a78bfa"

  handler: Per-subject handler (own NATS group)
  buffer: Per-table buffer (batch size or flush interval)
  ackflush: Ack AFTER durable flush (at-least-once; NAK re-delivers)

  handler -> buffer -> ackflush
}

# secondary input path: provider drop-zone ingestion (interval poller)
ingest: Drop-zone poller {
  style.fill: "#c4b5fd"
  stages: decode (magic-byte sniff) - validate - normalise (manifest field map)
  quarantine: "rejected rows persist to <provider>/rejected/ + onboarding_runs row"
}

nats -> sink.handler: "events x7 + profile.signal (batched) + behaviour.observed"
files -> ingest: poll incoming/
ingest -> lake.parts: profile_signals rows (+ PG memberships, match rate)

# ============================================================
# The lake  (Minio / S3)  -  a REAL Delta table
# ============================================================
lake: Delta lake (Minio / S3) {
  style.fill: "#faf5ff"

  parts: part-NNNNN.parquet {
    shape: cylinder
    style.fill: "#c72e49"
    style.font-color: "#fff"
  }
  log: _delta_log/ (real Delta protocol) {
    shape: cylinder
    style.fill: "#111827"
    style.font-color: "#fff"
    info: NDJSON actions - protocol / metaData / add / remove
  }
}
sink.ackflush -> lake.parts: write Parquet
sink.ackflush -> lake.log: commit add (v0 = protocol + metaData)

# ============================================================
# Compaction  (CronJob at :05)
# ============================================================
conductor: "batch-conductor (hourly CronJob) - the chain: checkpoint → compact → rollups → profile-builder → privacy" {
  shape: hexagon
  style.fill: "#f59e0b"
}

compact: "Compaction - runs IN the pipeline's process (single-writer rule)" {
  style.fill: "#fde68a"
}
conductor -> compact: POST /v1/datalake/compact
conductor -> builder: chain step (in-process)
compact -> lake.parts: bin-pack small files
compact -> lake.log: one atomic commit (add + N removes)

# ============================================================
# GDPR purge + profile summary  (pipeline = the lake's single writer)
# ============================================================
gdpr: "GDPR purge - POST /v1/datalake/purge (privacy-delete calls in)" {
  style.fill: "#581c87"
  style.font-color: "#fff"
}
gdpr -> lake.parts: filtered rewrite (drop user rows)
gdpr -> lake.log: one atomic commit (add survivor file + removes)

# ============================================================
# Profile-builder  (CronJob at :15)
# ============================================================
builder: Profile-builder (pkg/profilebuilder) {
  style.fill: "#fde68a"
}
lake -> builder: read behaviour_signals + profile_signals { style.stroke-dash: 2 }
builder -> lake.parts: identity_clusters artifact (purge + rewrite per run)

# ============================================================
# Read  ->  reporting cold path
# ============================================================
reader: Reporting cold read {
  style.fill: "#60a5fa"
  scan: DuckDB delta_scan (resolves active file set from the log)
}
lake -> reader.scan: delta_scan (tombstone-aware)
reader -> hotcold: merged in HotColdStore (see data-reporting)

hotcold: HotColdStore {
  style.fill: "#faff69"
}

legend: Legend {
  near: bottom-right
  style.fill: "#f8fafc"
  a: A
  b: B
  a -> b: sync
}
