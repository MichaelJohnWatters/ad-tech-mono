# Targeting data flow - how audience/profile data is collected (observed +
# onboarded), where the two sides meet (ClickHouse + profile-builder), and how the
# output is loaded back into live auctions and exports.
# Companion to docs/PLAN.md -> "Profile Store (Normalized Signals -> Expansion
# -> Memberships -> Export)". Render: make diagrams
# 🚧 marks planned components (Profile Store phases 1-5); the rest is live.

direction: right

# ============================================================
# Source side A - OBSERVED (pixel / auction exhaust)
# ============================================================
observed: Observed - pixel & auction side {
  style.fill: "#eff6ff"

  user: Browser / CTV device {shape: person}
  adtag: Ad tag + pixels (adtech.js)
  retarget: Retargeting pixel on advertiser sites (/v1/t/rt)

  user -> adtag
  user -> retarget
}

ssp: SSP :8084 {style.fill: "#60a5fa"}
tracker: Tracker :8083 {style.fill: "#60a5fa"}

observed.adtag -> ssp: ad request - user_id, uid2, hashed_email, ifa, IP->household, page context
observed.adtag -> tracker: impression / click / conversion / view
observed.retarget -> tracker: site_visit rows - consent-gated at capture, account+tag attributed

# ============================================================
# Source side B - ONBOARDED (first + third party)
# ============================================================
onboarded: Onboarded - 1st + 3rd party {
  style.fill: "#fefce8"

  owner: Advertiser / Publisher {shape: person}
  upload: Portal CSV/TSV upload - small files, PII hashed client-side
  api: Gateway /v1/api/audiences - JSON + multipart CSV/TSV, match rate per upload
  partner: Data partner {shape: person}
  dropzone: "Minio drop-zone adtech-onboarding/<provider>/ - csv/tsv/parquet, zip/gzip auto-detected" {shape: cylinder}

  owner -> upload -> api
  partner -> dropzone
}

# ============================================================
# Identity spine - who is the same person/household
# ============================================================
nats: NATS {
  shape: hexagon
  style.fill: "#22c55e"
  style.font-color: "#fff"
}
idc: identity-consumer {style.fill: "#a78bfa"}
pg_graph: identity_graph - PG edges, dedup upsert {shape: cylinder}

ssp -> nats: identity signals observed {style.stroke-dash: 3}
ssp -> nats: behaviour.observed - consented at capture, category stamped at event time {style.stroke-dash: 3}
tracker -> nats: event stream {style.stroke-dash: 3}
nats -> idc {style.stroke-dash: 3}
idc -> pg_graph
onboarded.api -> pg_graph: crm_match edges via /v1/api/identity-links

# ============================================================
# ClickHouse - where both sides land as replayable facts (ADR 0006)
# ============================================================
pipeline: Pipeline onboarding poller (cmd/pipeline) {style.fill: "#a78bfa"}
reporting: Reporting :8086 - NATS consumer {style.fill: "#60a5fa"}

lake: ClickHouse - THE analytical store {
  style.fill: "#faf5ff"

  events: event tables x7 - live {shape: cylinder}
  behaviour: behaviour_signals - user key + category, consent-gated {shape: cylinder}
  signals: profile_signals - normalized onboarded rows {shape: cylinder}
  clusters: identity_clusters - person_id -> member ids (PG) {shape: cylinder}
}

nats -> reporting {style.stroke-dash: 3}
reporting -> lake.events
reporting -> lake.behaviour
reporting -> lake.signals: normalize
onboarded.dropzone <- pipeline: poll, validate, quarantine rejects {style.stroke-dash: 2}
pipeline -> nats: profile.signal (drop-zone onboarding) {style.stroke-dash: 3}
onboarded.api -> nats: profile.signal - uploads (batched) {style.stroke-dash: 3}

# ============================================================
# THE MEETING POINT - profile-builder (batch, CronJob)
# ============================================================
builder: profile-builder - batch-conductor chain step (pkg/profilebuilder) {
  style.fill: "#f59e0b"

  cluster: 1 - cluster graph -> person_id (union-find)
  rules: 2 - behavioural rules (pure-Go over ClickHouse GROUP BY) + reconcile
  expand: 3 - enroll person, expand to every id in cluster

  cluster -> rules -> expand
}

pg_graph -> builder.cluster {style.stroke-dash: 2}
lake.behaviour -> builder.rules {style.stroke-dash: 2}
lake.signals -> builder.rules {style.stroke-dash: 2}
builder.cluster -> lake.clusters: versioned artifact
builder.expand -> pg_members: AddMembers + replace-by-segment prune
builder.expand -> nats: cache.invalidate.audience {style.stroke-dash: 3}

# ============================================================
# REAL-TIME loop - audience-rt (seconds, not the hourly batch)
# ============================================================
audiencert: audience-rt :8097 (pkg/retargeting) {
  style.fill: "#a78bfa"
  what: |md
    site_visit -> enroll (first-visit only, +TTL)
    purchase   -> suppress
  |
}
nats -> audiencert: behaviour.observed (site_visit) + conversion {style.stroke-dash: 3}
audiencert -> pg_members: enroll (TTL) / suppress / purge-expired
audiencert -> nats: cache.invalidate.audience + retargeting.enrolled (push) {style.stroke-dash: 3}

# ============================================================
# OUTPUT 1 - loaded back into live auctions
# ============================================================
pg_members: audience_segment_members (PG) {shape: cylinder}
preload: audience preloader - interval bulk push (pkg/audience/store/preload)
redis: "Redis - audience:user:<id>:<visibility>" {
  shape: cylinder
  style.fill: "#fecaca"
}

onboarded.api -> pg_members: direct path - live today
pg_members -> preload {style.stroke-dash: 2}
preload -> redis

serve: Live auction path {
  style.fill: "#eff6ff"

  stamp: SSP stamps user.ext.segments - public + household; user.data segtax=4 for IAB-labelled public segments (consent-gated at source)
  exchange: Exchange fan-out
  dsp: DSP unions dsp_private + audience bid modifiers price bids
  eval: targeting.Evaluate - include / exclude / modifiers

  stamp -> exchange -> dsp -> eval
}

# OUTPUT 1b - standards-interoperable audience data for EXTERNAL buyers:
# public segments labelled with an IAB Audience Taxonomy node (migration 062)
# ride the fan-out as OpenRTB user.data + ext.segtax=4 — interpretable
# outside the platform, unlike the internal ids on user.ext.segments.
extdsp: External DSPs (extbidder et al) - receive user.data ext.segtax=4 {shape: hexagon}
serve.exchange -> extdsp: OpenRTB over the network boundary

# Data monetization (ADR 0009): fee-bearing labelled segments earn for their
# owner when an external buyer wins - attribution NEVER rides the request
# (SSP publishes DataFeeEvent; reporting accrues at impression).
datafee_out: "Data earnings - owner credited fee x (1 - margin) per delivered impression" {shape: page}
serve.stamp -> datafee_out: DataFeeEvent on external win {style.stroke-dash: 3}

redis -> serve.stamp: 25ms budget {style.stroke-dash: 2}
redis -> serve.dsp: 25ms budget {style.stroke-dash: 2}
pg_graph -> serve.dsp: read-time BFS freshness top-up (opt-in) {style.stroke-dash: 2}

# ============================================================
# OUTPUT 2 - exports & transparency
# ============================================================
exports: Segment exports - CSV/Parquet artifacts via report jobs {shape: page}
profileapi: "Profile API - GET /v1/api/profiles/<id> (staff, support:read)"

pg_members -> exports
lake.clusters -> profileapi {style.stroke-dash: 2}
pg_members -> profileapi {style.stroke-dash: 2}

legend: Legend {
  near: bottom-right
  style.fill: "#f8fafc"
  a: A
  b: B
  c: C
  d: D
  a -> b: sync call
  a -> c: async NATS {style.stroke-dash: 3}
  a -> d: read / query {style.stroke-dash: 2}
  note: 🚧 = planned (Profile Store plan)
}
