# Ad Tech Platform — System Architecture (by plane)
# Render: make diagrams   (or: d2 docs/diagrams/architecture.d2 docs/diagrams/architecture.svg)
# Legend + "update when" index: docs/diagrams/README.md

direction: right

# ============================================================
# Legend (same key in every D2 diagram — see README)
# ============================================================
legend: Legend {
  near: top-left
  grid-columns: 1
  style.fill: "#f8fafc"

  actor: External actor { shape: person; style.fill: "#94a3b8" }
  svc: Service (cmd/*) { style.fill: "#e2e8f0" }
  store: Datastore { shape: cylinder; style.fill: "#cbd5e1" }
  bus: Event bus { shape: queue; style.fill: "#22c55e" }

  s1: A; s2: B; s1 -> s2: sync HTTP/gRPC
  a1: A; a2: B; a1 -> a2: async NATS { style.stroke-dash: 4 }
  r1: A; r2: B; r1 -> r2: read/query { style.stroke-dash: 2; style.stroke: "#64748b" }
}

# ============================================================
# External actors
# ============================================================
browser:    Browser / Pub SDK { shape: person; style.fill: "#94a3b8" }
advertiser: Advertiser         { shape: person; style.fill: "#818cf8" }
publisher:  Publisher          { shape: person; style.fill: "#34d399" }

# ============================================================
# CONTROL plane  (gateway, portals, config)
# ============================================================
control: Control plane {
  style.fill: "#f1f5f9"

  gateway: Gateway :8080 {
    style.fill: "#4361ee"; style.font-color: "#fff"
    portals: Portals (advertiser / publisher / staff)
    api: REST API + JWT/RBAC · proxy
    scope: enforceReportTenant (tenant scoping)
    ops: Staff ops console (/v1/api/ops · ops:read/deploy)
  }
}

# Staff ops console: the gateway's in-cluster kubeops client (SA "gateway",
# namespace Role) drives pod matrix / rollout restarts / cron triggers / log
# tails; NATS lag comes from the monitor port.
k8sapi: k8s API server { shape: cylinder; style.fill: "#326ce5"; style.font-color: "#fff"; d: pods · deployments · cronjobs/jobs · pvcs }
control.gateway -> k8sapi: kubeops (list/patch/create · RBAC) { style.stroke-dash: 2; style.stroke: "#64748b" }
control.gateway -> events.nats: jsz lag summary (:8222 monitor) { style.stroke-dash: 2; style.stroke: "#64748b" }

browser    -> control.gateway: HTTP/HTMX
advertiser -> control.gateway: REST + JWT
publisher  -> control.gateway: REST + JWT

# ============================================================
# SERVING plane  (synchronous RTB path)
# ============================================================
serving: Serving · sync RTB {
  style.fill: "#eef2ff"

  ssp: SSP :8084          { style.fill: "#34d399"; d: placements · floors · bid-req gen }
  exchange: Exchange :8081 { style.fill: "#818cf8"; d: first-price auction · deal priority · 4-DSP fan-out }
  dsp: DSP internal :8082  { style.fill: "#22d3ee"; d: bid · targeting · pacing · shading }
  dspc: DSP competitors ×3 { style.fill: "#fb923c"; d: :8089 slowpoke · :8090 deadbeat · :8098 healthy (SmartRouter scenarios) }
  adserver: Ad Server :8085 { style.fill: "#a78bfa"; d: creative resolve · macros · pixel URLs }
  pubad: Publisher Ad Server :8088 { style.fill: "#a78bfa"; d: serves markup to the page }
  tracker: Tracker :8083   { style.fill: "#fbbf24"; d: imp · click · conv · view }

  ssp -> exchange: OpenRTB · gRPC
  exchange -> dsp: OpenRTB · gRPC
  exchange -> dspc: OpenRTB HTTP
  ssp -> adserver: serve · gRPC
}

control.gateway -> serving.ssp: ad request
browser -> serving.pubad: page ad slot
serving.pubad -> serving.ssp: bid request
browser -> serving.tracker: pixels

# ============================================================
# ASYNC / EVENTS plane  (NATS + consumers)
# ============================================================
events: Async · events {
  style.fill: "#ecfdf5"

  nats: NATS JetStream {
    shape: queue; style.fill: "#22c55e"; style.font-color: "#fff"
    s: |md
      adtech.events.{impression,click,conversion,view}
      adtech.auction.{win,complete}
      adtech.billing.campaign_spend_snapshot
    |
  }

  reporting: Reporting :8086 {
    style.fill: "#60a5fa"
    consumer: NATS consumer (+ ClickHouse batch)
    engine: QueryEngine (ecpm/ctr/fill_rate/net)
    hotcold: HotColdStore (hot↔cold router)
    billing: Billing engine (accrue + settle)
    rollups: Rollup engine
  }

  pipeline: Pipeline :8087 {
    style.fill: "#a78bfa"
    dropzone: Onboarding drop-zone poller (csv/tsv/parquet, zip/gz)
    signal: "publishes profile.signal → NATS (→ reporting → ClickHouse)"
  }

  webhooks: Webhooks :8091 { style.fill: "#f472b6"; d: HMAC HTTP delivery }
  identity: Identity consumer :8092 { style.fill: "#c084fc"; d: builds identity graph }
}

# serving publishes async events
serving.tracker  -> events.nats: events { style.stroke-dash: 4 }
serving.exchange -> events.nats: auction.win / complete { style.stroke-dash: 4 }
serving.exchange -> events.reporting: routing warm-start + reseed (dsp_calls aggregate) { style.stroke-dash: 2; style.stroke: "#64748b" }
serving.ssp      -> events.nats: identity.observed + behaviour.observed (consent-gated) { style.stroke-dash: 4 }
control.gateway  -> events.nats: profile.signal (audience uploads, batched) { style.stroke-dash: 4 }
events.pipeline  -> events.nats: profile.signal (drop-zone onboarding) { style.stroke-dash: 4 }

# nats fans out to consumers
events.nats -> events.reporting: consume { style.stroke-dash: 4 }
events.nats -> events.webhooks: consume { style.stroke-dash: 4 }
events.nats -> events.identity: consume { style.stroke-dash: 4 }

# ============================================================
# DATA / ANALYTICS plane  (hot + cold)
# ============================================================
data: Data · analytics {
  style.fill: "#faf5ff"

  clickhouse: ClickHouse {
    shape: cylinder; style.fill: "#faff69"; d: THE analytical store · HOT (recent) + rollup MVs + signals
  }
  lake: Parquet export (Minio, derived) {
    shape: cylinder; style.fill: "#c72e49"; style.font-color: "#fff"
    d: COLD archive · hourly export from ClickHouse
  }
}

events.reporting -> data.clickhouse: write + query (hot)
events.reporting -> data.lake: hourly INSERT INTO FUNCTION s3() (derived export)
events.reporting -> data.lake: ClickHouse s3() cold reads { style.stroke-dash: 2; style.stroke: "#64748b" }
control.gateway  -> events.reporting: /v1/api/reports (tenant-scoped) { style.stroke-dash: 2; style.stroke: "#64748b" }

# The data chain, completion-ordered (pkg/batch) — replaced the
# time-staggered CronJob lattice. Steps recorded in batch_runs (staff portal).
conductor: "batch-conductor (CronJob :10) - checkpoint → rollups → ch-parquet-export → profile-builder → privacy" { shape: hexagon; style.fill: "#f59e0b" }
conductor -> events.reporting: rollup runs (minute → monthly) + ch-parquet-export
conductor -> data.clickhouse: profile-builder step - read signals (server-side GROUP BY) { style.stroke-dash: 2; style.stroke: "#64748b" }

onboardingzone: "Minio adtech-onboarding (drop-zone bucket)" { shape: cylinder; style.fill: "#fef08a" }
events.pipeline -> onboardingzone: poll incoming/ · quarantine rejected/ { style.stroke-dash: 2; style.stroke: "#64748b" }

# Async report builder: gateway enqueues jobs in Postgres (SKIP LOCKED queue);
# the report-runner worker queries reporting, renders CSV/JSON/Parquet into the
# private adtech-reports bucket, and emails download links. Downloads stream
# back through the gateway (auth + ownership), never a public bucket URL.
data.reportrunner: Report-runner :8095 {
  style.fill: "#60a5fa"
  d: schedules → jobs → artifacts (CSV/JSON/Parquet)
}
data.reports: Reports bucket (Minio/S3) {
  shape: cylinder; style.fill: "#c72e49"; style.font-color: "#fff"
  d: PRIVATE · adtech-reports · 30d retention
}
control.gateway -> data.reportrunner: report_jobs queue (Postgres) { style.stroke-dash: 2; style.stroke: "#64748b" }
control.gateway -> events.reporting: "staff profile summary + Batch-runs snapshot (/v1/reporting/profile, /debug snapshot proxy)" { style.stroke-dash: 2; style.stroke: "#64748b" }
data.reportrunner -> events.reporting: /v1/reporting/query (per-job deadline)
data.reportrunner -> data.reports: write artifact
control.gateway -> data.reports: stream download (auth'd) { style.stroke-dash: 2; style.stroke: "#64748b" }
email: Email (Mailpit / SES) { shape: hexagon; style.fill: "#f472b6" }
data.reportrunner -> email: report-ready link { style.stroke-dash: 4 }

# ============================================================
# MONEY plane  (budgets, billing ledger)
# ============================================================
money: Money {
  style.fill: "#fffbeb"

  redis_budget: Redis {
    shape: cylinder; style.fill: "#dc382d"; style.font-color: "#fff"
    d: budget counters · balance cache · freq caps · dedup
  }
  tigerbeetle: TigerBeetle {
    shape: cylinder; style.fill: "#111827"; style.font-color: "#fff"
    d: double-entry billing ledger
  }
}

serving.dsp -> money.redis_budget: spend gate + record (local win-notice)
events.reporting -> money.tigerbeetle: accrue / settle (double-entry)
events.reporting -> money.redis_budget: advertiser balance drawdown
events.reporting -> events.nats: campaign_spend_snapshot { style.stroke-dash: 4 }
events.nats -> serving.dsp: reconcile pacing counters { style.stroke-dash: 4 }

# ============================================================
# Shared infra + observability
# ============================================================
postgres: PostgreSQL { shape: cylinder; style.fill: "#336791"; style.font-color: "#fff"; d: accounts · campaigns · placements · config (RLS) }

control.gateway  -> postgres: accounts · config
serving.dsp      -> postgres: campaigns (warm cache)
serving.ssp      -> postgres: placements (warm cache)
events.reporting -> postgres: contracts · saved reports

obs: Observability {
  style.fill: "#f8fafc"
  grafana: Grafana { style.fill: "#f46800"; style.font-color: "#fff" }
  prometheus: Prometheus { shape: cylinder; style.fill: "#e6522c"; style.font-color: "#fff" }
  loki: Loki { shape: cylinder; style.fill: "#f4b400" }
  jaeger: Jaeger { style.fill: "#66d3f8" }
  grafana -> prometheus: metrics
  grafana -> loki: logs (trace_id pivots)
  grafana -> jaeger: traces
}
