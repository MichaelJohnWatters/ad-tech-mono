# Data lifecycle - the high-level SPINE that ties the segment diagrams together.
# Companion to docs/diagrams/data-lifecycle.md (the linear teaching walk with the
# ASCII + Mermaid + worked example). This D2 is deliberately COARSE: it shows the
# stages, the fork, the two spines and the feedback loops - the detail lives in
# auction-flow / nats-events / data-pipeline / data-reporting / targeting-data-flow /
# billing-flow / cache-freshness. Render: make diagrams

direction: right

# ============================================================
# 1 - SOURCES (two lanes)
# ============================================================
sources: 1 - Sources {
  style.fill: "#eff6ff"
  observed: Observed - pixels + auction exhaust {
    user: Browser / CTV {shape: person}
    sdk: adtech.js + 7 pixels (imp/click/view/video/audio + conv + rt)
    user -> sdk
  }
  onboarded: Onboarded - 1st + 3rd party {
    owner: Advertiser / Publisher {shape: person}
    upload: Portal upload -> /v1/api/audiences
    dropzone: Partner drop-zone (Minio) {shape: cylinder}
    owner -> upload
    owner -> dropzone
  }
}

# ============================================================
# 2 - AUCTION (produces the observed lane)
# ============================================================
auction: 2 - Auction {
  style.fill: "#eff6ff"
  ssp: SSP :8084 {style.fill: "#60a5fa"}
  exch: Exchange {style.fill: "#60a5fa"}
  dsp: DSP :8082 {style.fill: "#60a5fa"}
  ads: Ad Server (display / VAST / DAAST / SSAI) {style.fill: "#60a5fa"}
  trk: Tracker :8083 {style.fill: "#60a5fa"}
  ssp -> exch -> dsp -> ads: win
  ads -> trk: signed beacons
}

sources.observed.sdk -> auction.ssp: ad request (identity signals)
sources.observed.sdk -> auction.trk: conv / rt / imp pixels

# ============================================================
# 3 - NATS FORK (one stream, independent consumer groups)
# ============================================================
nats: 3 - NATS JetStream (adtech.*) {
  shape: hexagon
  style.fill: "#22c55e"
  style.font-color: "#fff"
}
auction.ssp -> nats {style.stroke-dash: 3}
auction.exch -> nats {style.stroke-dash: 3}
auction.trk -> nats {style.stroke-dash: 3}

# ============================================================
# 6 - HOT: reporting -> ClickHouse -> rollups -> read path
# ============================================================
hot: 6 - Rollups (HOT) {
  style.fill: "#fffbeb"
  rep: Reporting :8086 {style.fill: "#60a5fa"}
  ch: ClickHouse {shape: cylinder; style.fill: "#fde68a"}
  tiers: raw -> minute -> hourly -> daily -> monthly {shape: cylinder; style.fill: "#fde68a"}
  rep -> ch -> tiers: cascade + purge finer tier
}
nats -> hot.rep: reporting group {style.stroke-dash: 3}

read: Read path {
  style.fill: "#f8fafc"
  portal: Portal
  gw: Gateway (enforceReportTenant)
  qe: QueryEngine + AutoTier + HotColdStore
  portal -> gw -> qe
}
hot.tiers -> read.qe: hot rows {style.stroke-dash: 2}
read.qe -> read.portal: rows

# ============================================================
# 4 - COLD: pipeline -> Delta lake (replayable, keep-forever)
# ============================================================
cold: 4 - Lake (COLD) {
  style.fill: "#faf5ff"
  sink: Pipeline sink :8087 (ack after flush) {style.fill: "#a78bfa"}
  lake: Delta lake - Parquet + _delta_log {shape: cylinder; style.fill: "#c72e49"; style.font-color: "#fff"}
  sink -> lake
}
nats -> cold.sink: pipeline group {style.stroke-dash: 3}
sources.onboarded.upload -> cold.lake: lake copy {style.stroke-dash: 3}
sources.onboarded.dropzone -> cold.sink: poll -> decode/map/validate/quarantine {style.stroke-dash: 2}
cold.lake -> read.qe: cold rows (delta_scan) {style.stroke-dash: 2}

# ============================================================
# 5 - AUDIENCE: identity -> profile-builder -> members -> back to auction
# ============================================================
idc: identity-consumer -> identity_graph {style.fill: "#a78bfa"}
nats -> idc: identity group {style.stroke-dash: 3}

audience: 5 - Audience {
  style.fill: "#fff7ed"
  builder: profile-builder {style.fill: "#f59e0b"}
  pbflow: cluster (union-find) -> segment (onboarded/rule/composite/lookalike) -> expand to cluster
  members: audience_segment_members (PG) {shape: cylinder}
  redis: Redis - audience:user:id {shape: cylinder; style.fill: "#fecaca"}
  builder -> pbflow -> members -> redis
}
idc -> audience.builder: id edges {style.stroke-dash: 2}
cold.lake -> audience.builder: behaviour + profile signals {style.stroke-dash: 2}
sources.onboarded.upload -> audience.members: direct fast path
audience.redis -> auction.ssp: FEEDBACK - stamp segments (25ms) {style.stroke-dash: 2; style.stroke: "#16a34a"}
audience.redis -> auction.dsp: FEEDBACK - bid modifiers {style.stroke-dash: 2; style.stroke: "#16a34a"}
audience.members -> exports: exports + Profile API {shape: page}

# ============================================================
# MONEY (books on the IMPRESSION, not the win)
# ============================================================
money: Money lane {
  style.fill: "#ecfdf5"
  bill: Billing engine (impression -> reserve/settle) {style.fill: "#34d399"}
  tb: TigerBeetle ledger {shape: cylinder}
  bal: advertiser balance + publisher payout {shape: cylinder}
  committed: committed_spend (PG) {shape: cylinder}
  bill -> tb -> bal
  bill -> committed
}
auction.trk -> money.bill: impression / click / conv / view {style.stroke-dash: 3}
money.bal -> auction.dsp: prepay GATE (no funds -> no bid) {style.stroke-dash: 2; style.stroke: "#dc2626"}
money.committed -> auction.dsp: FEEDBACK - pacing reconcile {style.stroke-dash: 2; style.stroke: "#16a34a"}
money.committed -> invoices: monthly invoice-runner {shape: page}

# ============================================================
# PRIVACY (the flow that runs BACKWARDS through all 3 stores)
# ============================================================
privacy: Privacy - right to be forgotten {
  style.fill: "#faf5ff"
  optout: opt-out (level 1/2/3) -> opt_out_registry {shape: cylinder; style.fill: "#581c87"; style.font-color: "#fff"}
  del: privacy-delete (level 3) {style.fill: "#7c3aed"; style.font-color: "#fff"}
  optout -> del
}
privacy.del -> idc: purge identity edges {style.stroke-dash: 2; style.stroke: "#7c3aed"}
privacy.del -> audience.members: drop memberships {style.stroke-dash: 2; style.stroke: "#7c3aed"}
privacy.del -> cold.lake: filtered rewrite {style.stroke-dash: 2; style.stroke: "#7c3aed"}

# ============================================================
# SERVING CACHES (the OTHER circulatory system - never analytics)
# ============================================================
serving: Serving caches (sub-ms) {
  style.fill: "#f0f9ff"
  pg: Postgres - campaigns/placements/creatives/balances/deals {shape: cylinder}
  warm: in-process warm caches (18 invalidate subjects + 30s poll) {style.fill: "#93c5fd"}
  pg -> warm
}
serving.warm -> auction.dsp: reads only these + Redis {style.stroke-dash: 2}
serving.warm -> auction.ssp {style.stroke-dash: 2}

legend: Legend {
  near: bottom-right
  style.fill: "#f8fafc"
  a: A
  b: B
  c: C
  a -> b: sync / data
  a -> c: async NATS {style.stroke-dash: 3}
  note: green = feedback loop into serving · red = gate · purple = deletion · dashed-2 = read/query
}
