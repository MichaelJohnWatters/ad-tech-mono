# Money — budgets (fast) to ledger (truth) to payout
# Render: make diagrams
# The Money plane: fast Redis gates at bid time, reconciled to the TigerBeetle
# ledger which is the accounting source of truth. See e2e-trace.md sections 1 and 4.

direction: down

# ============================================================
# 1 - Budgets and pacing  (FAST path - Redis, at bid time)
# ============================================================
budgets: Budgets and pacing (fast, Redis) {
  style.fill: "#b45309"
  style.font-color: "#fff"

  balance_gate: Prepay-balance gate (no funds, no bid)
  budget_gate: Daily-budget gate (stop at daily_budget)
  win_notice: Local win-notice decrement (instant, approximate)
  reconcile: Reconcile to committed-spend snapshot (authoritative)

  win_notice -> reconcile: overwritten by truth
}

dsp: DSP :8082 {
  style.fill: "#22d3ee"
}
dsp -> budgets.balance_gate: check
dsp -> budgets.budget_gate: check
dsp -> budgets.win_notice: on win

# ============================================================
# 2 - Accrual and settlement  (on the EVENT - Reporting hosts billing)
# ============================================================
accrual: Accrual and settlement (Reporting billing engine) {
  style.fill: "#166534"
  style.font-color: "#fff"

  win: AuctionWinEvent - single source of truth for cost {
    shape: parallelogram
  }
  cpm: CPM - accrue on IMPRESSION
  cpc: CPC - reserve on win, settle on click (else expire)
  cpa: CPA / vCPM / CPCV - reserve, settle on event (else expire)

  win -> cpm
  win -> cpc
  win -> cpa
}

# ============================================================
# 3 - The ledger (accounting source of truth)
# ============================================================
ledger: TigerBeetle ledger {
  shape: cylinder
  style.fill: "#111827"
  style.font-color: "#fff"
  info: double-entry (debit advertiser, credit publisher + platform); backend = memory or tigerbeetle
}
accrual -> ledger: post transfers (double-entry)

balances: advertiser_balances (Redis) {
  shape: cylinder
  style.fill: "#dc382d"
  style.font-color: "#fff"
}
accrual -> balances: prepay drawdown + invalidate DSP cache
accrual -> budgets.reconcile: campaign_spend_snapshot (NATS) {
  style.stroke-dash: 4
}

# ============================================================
# 4 - Revenue share  (publisher NET - contract per publisher)
# ============================================================
revenue: Revenue share models {
  style.fill: "#581c87"
  style.font-color: "#fff"
  fixed: Fixed fee percent
  tiered: Tiered (volume brackets)
  guaranteed: Guaranteed min CPM
  deal: Deal-type modifiers
  hybrid: Hybrid
}
ledger -> revenue: gross to net (CalculateRevenue)

# ============================================================
# 5 - Output
# ============================================================
output: Output {
  invoice: Advertiser invoice (monthly)
  payout: Publisher payout (net-30)
  recon: Daily reconciliation check
  payout -> recon: verify vs ledger
}
revenue -> output.payout
ledger -> output.invoice

# Data monetization (ADR 0009): an EXTERNAL buyer's win on a request that
# carried fee-bearing segments parks a DataFeeEvent; the delivered impression
# settles it — owner credited fee net of margin, external seat accrues a
# receivable (invoiced out-of-band; external seats hold no prepay balance).
datafee: Data-fee accrual {
  pending: data_fee_pending (durable trace join)
  settle: "impression -> owner balance credit (net) + platform margin + extseat receivable"
  pending -> settle: impression for trace arrives
}
datafee.settle -> ledger: double-entry (reference_type=data_fee)

legend: Legend {
  near: bottom-right
  style.fill: "#f8fafc"
  a: A
  b: B
  a -> b: sync
  c: A2
  d: B2
  c -> d: NATS async {
    style.stroke-dash: 4
  }
}
