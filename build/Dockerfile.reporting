# Reporting Dockerfile — CGO enabled for tigerbeetle-go (the billing ledger).
# No `duckdb` tag: cold reads go through ClickHouse s3() (pure Go) since
# ADR 0006 phase 3, so the glibc go-duckdb build (Dockerfile.reporting.duckdb)
# is retired from the dev loop.
FROM golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder
WORKDIR /src
RUN apk add --no-cache gcc musl-dev
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o /app ./cmd/reporting

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates
COPY --from=builder /app /app
# NOTE: reporting stays ROOT + hardenedExempt (values) — its tigerbeetle-go CGO
# client SIGSEGVs under the hardened securityContext (drop ALL caps / seccomp).
# Revisit with a tuned seccomp profile if we want it non-root.
ENTRYPOINT ["/app"]
