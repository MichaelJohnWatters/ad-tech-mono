# Dockerfile.transcode — dev image for the ffmpeg-backed services
# (cmd/transcoder, cmd/content-packager). Same pre-built-binary pattern as
# Dockerfile.dev, but with ffmpeg installed. Kept separate so we don't bloat
# every service image with ffmpeg (~a few hundred MB of codecs).
#
# Usage:
#   docker build --build-arg SERVICE=transcoder -f build/Dockerfile.transcode -t adtech-transcoder .
#
# Prereq: ./bin/${SERVICE} built on the host (the Tiltfile's ${svc}-build does this).

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates ffmpeg && adduser -D -u 1000 app
ARG SERVICE
COPY bin/${SERVICE} /app
WORKDIR /
USER 1000:1000
ENTRYPOINT ["/app"]
