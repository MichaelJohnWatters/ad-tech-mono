# Dockerfile.dev — pod-mode dev iteration image.
#
# Unlike build/Dockerfile (which runs `go build` INSIDE the image and
# produces a fully-prod-shaped image), this one copies a pre-built
# binary from the host's ./bin/${SERVICE} location. That makes it tiny
# and trivially fast to rebuild, but more importantly it pairs with
# Tilt's live_update feature: when the operator edits Go code, Tilt
# rebuilds ./bin/${SERVICE} on the host (~1-2s for incremental Go
# builds), then rsyncs the new binary into the running pod and
# restart_container() bounces the process in <1s. No Docker layer
# rebuild, no image pull, no pod scheduling overhead.
#
# Usage:
#   docker build --build-arg SERVICE=dsp -f build/Dockerfile.dev -t adtech-dsp .
#
# Prerequisite: ./bin/${SERVICE} must exist on the host. The Tiltfile
# wires this via a local_resource('${svc}-build') that runs
# `go build -o ./bin/${svc} ./cmd/${svc}` before docker_build.
#
# For prod / CI use build/Dockerfile (or build/Dockerfile.gateway,
# build/Dockerfile.reporting for the variants).

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
# Non-root runtime user (uid 1000). Pairs with the gated pod securityContext
# (global.hardenedContainers). Static Go binary binding a high port + writing
# only /tmp — no root needed. COPY leaves /app + assets world-readable.
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 app
ARG SERVICE
COPY bin/${SERVICE} /app
# Optional service-specific assets (gateway needs web/, others don't).
# We always COPY web/ if present so the same dev image works for
# gateway too. Other services ignore it.
COPY web /web
# Profile YAMLs (DSP identity fallback when the dsps row doesn't exist yet;
# also publisher configs). Small, and their absence caused silent
# defaults-only behaviour in pod mode.
COPY profiles /profiles
WORKDIR /
USER 1000:1000
ENTRYPOINT ["/app"]
