# Dockerfile.migrate — the goose migration runner for the Helm hook.
#
# cmd/migrate reads the migrations DIRECTORY at runtime (MIGRATIONS_DIR,
# default "migrations") — it does not embed the SQL. The generic
# build/Dockerfile ships only the binary, which is why it can't be used
# here: the container needs the .sql files too.
#
# Same pre-built-binary pattern as Dockerfile.dev:
#   go build -o ./bin/migrate ./cmd/migrate
#   docker build -f build/Dockerfile.migrate -t adtech-migrate .

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache ca-certificates && adduser -D -u 1000 app
COPY bin/migrate /app
COPY migrations /migrations
ENV MIGRATIONS_DIR=/migrations
USER 1000:1000
ENTRYPOINT ["/app"]
