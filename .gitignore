# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Build output
bin/
# Stray root-level binaries from `go build ./cmd/<svc>` (belong in bin/)
/compact
/migrate
/seed
/simulator

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets (never commit). The DECRYPTED SOPS overlays + age keys stay local;
# only the encrypted *.enc.yaml and the *.example.yaml template are committed.
*.enc.yaml.dec
secrets.yaml
k8s/helm/adtech/secrets/*.secrets.yaml
!k8s/helm/adtech/secrets/*.example.yaml
age.key
*.age
age-key.txt

# Python
__pycache__/
*.pyc
.venv/
venv/

# k6 results
k6-results/

# Stale Go binaries that get created when `go build ./cmd/xxx` runs from
# the repo root (Tiltfile uses `-o ./bin/xxx` so this only happens for
# ad-hoc local builds). These should never be committed.
/adserver
/dsp
/exchange
/gateway
/reporting
/seed
/ssai
/ssp
/tracker
/transcoder
/billing
/webhooks
/notifications
/identity-consumer
/pipeline
/report-runner
/content-packager
/demoadv
/demosite
/extbidder
/simulator
/ssp
/tracker
/pipeline
/publisher-adserver


# mkcert-issued localhost certs for the dev gateway's HTTPS listener.
# Per-developer; never checked in. Regenerate with scripts/setup-tls.sh.
dev/tls/

# Third-party checkouts for local reference demos (e.g. scripts/asciline-demo.sh).
# Never vendored — cloned on demand, per-developer.
third_party/
/report-runner
.claude/worktrees/
/demosite
/extbidder
/demoadv
/taxonomy-import
perf-archives/

# Micro-benchmark transient run output (baseline.txt is committed)
docs/perf/bench/.last.txt
docs/perf/bench/profiles/
docs/perf/bench/history/
docs/perf/bench/.max.txt
